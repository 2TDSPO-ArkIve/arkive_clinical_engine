ORACLE_DSN=oracle.fiap.com.br:1521/ORCL
ORACLE_USER=rm561996
ORACLE_PASSWORD=230602
GROQ_API_KEY=<API_KEY>
LOG_LEVEL=INFO

# Limiar de confiança (0-100): abaixo disso, a busca web é acionada.
AMBIGUITY_THRESHOLD=80

# Quantos diagnósticos anteriores do mesmo animal são buscados e injetados
# no resumo clínico enviado à IA (Parte 3/4 do plano).
DIAGNOSTIC_HISTORY_LIMIT=5

# Modelo Groq principal + cadeia de fallback, em ordem de tentativa
GROQ_MODEL_PRIMARY=qwen/qwen3.6-27b
GROQ_MODEL_FALLBACKS=openai/gpt-oss-20b,openai/gpt-oss-120b

# Retry com backoff para erros transitórios (timeout, conexão, 5xx) no
# MESMO modelo, antes de passar para o próximo da lista.
GROQ_MAX_RETRIES_PER_MODEL=2
GROQ_RETRY_BACKOFF_SECONDS=2