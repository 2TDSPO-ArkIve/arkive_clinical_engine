ORACLE_DSN=oracle.fiap.com.br:1521/ORCL
ORACLE_USER=rm561996
ORACLE_PASSWORD=230602
GROQ_API_KEY=<API_KEY>
# token Read do HF: o modelo do RAG (Sabelli/arkive-e5-vet) é privado
HF_TOKEN=<API_KEY>
LOG_LEVEL=INFO

# pc_confianca abaixo disto aciona a busca web (0-100)
AMBIGUITY_THRESHOLD=80

DIAGNOSTIC_HISTORY_LIMIT=5
HISTORICO_CUIDADO_LIMIT=5
# tamanho máximo (caracteres) da transcrição de voz enviada ao LLM
MAX_TRANSCRICAO_CHARS=6000
# corte (caracteres) do abstract de cada artigo PubMed; 3 artigos vão ao LLM
PUBMED_ABSTRACT_CHARS=700
# máximo de predisposições (TB_ARKIVE_DOENCA) enviadas ao LLM, as mais ligadas ao relato primeiro
PREDISPOSICAO_LIMIT=5
# corte (caracteres) de DS_DOENCA e DS_SINTOMAS de cada predisposição
PREDISPOSICAO_DESC_CHARS=400
# segundos máximos para embedar doenças novas no ranking semântico; estourou, usa ranking lexical
PREDISPOSICAO_RANK_TIMEOUT_S=10
# máximo de relatos dos responsáveis (TB_ARKIVE_RELATO_ANIMAL) enviados ao LLM, os mais recentes primeiro
RELATO_RESPONSAVEL_LIMIT=5
# corte (caracteres) de cada relato do responsável
RELATO_RESPONSAVEL_CHARS=600

GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACKS=qwen/qwen3.8-27b,openai/gpt-oss-20b
# esforço de raciocínio dos gpt-oss (low, medium, high); conta no limite de tokens por minuto
GROQ_REASONING_EFFORT=medium
# retry no mesmo modelo só para erro transitório (timeout, conexão, 5xx)
GROQ_MAX_RETRIES_PER_MODEL=2
GROQ_RETRY_BACKOFF_SECONDS=2

RAG_TOP_K=3
RAG_MAX_CHARS=4500
# similaridade mínima (0-1) para um documento ir ao LLM
RAG_MIN_SCORE=0.45
