ORACLE_DSN=oracle.fiap.com.br:1521/ORCL
ORACLE_USER=rm561996
ORACLE_PASSWORD=230602
GROQ_API_KEY=<API_KEY>

# Nível de log exibido no console (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# INFO mostra o fluxo normal da execução (etapas do pipeline, decisões
# tomadas); use DEBUG só para depuração detalhada.
LOG_LEVEL=INFO

# Limiar do score de qualidade dos dados clínicos (0-100, calculado em
# _evaluate_ambiguity_locally). Se o score ficar ABAIXO deste valor, a busca
# web é acionada para enriquecer o diagnóstico. Quanto maior o valor, mais
# facilmente a busca web é disparada (menos tolerante a dados incompletos).
AMBIGUITY_THRESHOLD=80

# Limiar da confiança diagnóstica calculada deterministicamente em Python
# (0-100, calculado em _calculate_confidence). Se pc_confianca ficar ABAIXO
# deste valor, a busca web é acionada — mesmo que os dados estejam completos
# (ex: sintomas inespecíficos geram confiança baixa por si só).
CONFIDENCE_THRESHOLD=70

# Cache de buscas web (DuckDuckGo)
WEB_SEARCH_CACHE_TTL_SECONDS=3600
WEB_SEARCH_CACHE_MAX_SIZE=200

# Bônus (pontos percentuais) somado ao pc_confianca quando a busca web
# retorna ao menos uma fonte (geral e/ou dedicada de predisposição).
# Reflete que o diagnóstico final incorporou mais evidência do que os
# dados locais do Oracle isoladamente sustentavam. Resultado sempre
# capado em 100 — sem fontes encontradas, nenhum bônus é aplicado.
WEB_ENRICHMENT_CONFIDENCE_BONUS=12

# Histórico de diagnósticos anteriores no prompt
DIAGNOSTIC_HISTORY_LIMIT=5